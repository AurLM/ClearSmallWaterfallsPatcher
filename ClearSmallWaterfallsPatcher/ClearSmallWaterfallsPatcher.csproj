<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- same versions as Synthesis 0.36.5's own patcher template -->
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.2" />
    <PackageReference Include="Mutagen.Bethesda.Synthesis" Version="0.36.5" />
  </ItemGroup>

</Project>
